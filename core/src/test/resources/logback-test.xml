<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%level %logger{36} - %msg%n</pattern></encoder>
    </appender>
    <logger name="ca.uhn.hl7v2.conf.check.DefaultValidator" level="ERROR"/>
    <root level="WARN"><appender-ref ref="CONSOLE"/></root>
</configuration>
